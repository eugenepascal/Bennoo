# Copier ce fichier en .env puis renseigner les valeurs. Ne jamais commiter .env.
# L'application refuse de démarrer si une variable obligatoire manque (src/lib/env.ts).

# Base de données PostgreSQL (docker-compose.yml expose ce serveur en local)
DATABASE_URL="postgresql://bennoo:bennoo@localhost:5432/bennoo"

# URL publique de l'application (sert aux liens d'invitation et à la vérification Origin)
APP_URL="http://localhost:3000"

# Secret de signature des sessions Better Auth : 32 caractères aléatoires minimum
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""

# Stockage objet S3 compatible (MinIO en local)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="eu-west-3"
S3_BUCKET="bennoo-media"
S3_ACCESS_KEY_ID="bennoo"
S3_SECRET_ACCESS_KEY="bennoo-dev-secret"

# Email (Mailpit en local : interface sur http://localhost:8025)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Bennoo <no-reply@localhost>"
