{
  "name": "bennoo",
  "version": "0.1.0",
  "private": true,
  "description": "Bennoo — Une cérémonie, toute la famille, un seul endroit.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-bennoo \"node --test 'tests/rules/**/*.test.js'\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-bennoo \"playwright test\"",
    "serve": "firebase emulators:start --only auth,firestore,hosting --project demo-bennoo"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.55.0",
    "firebase": "^12.18.0",
    "firebase-tools": "^15.20.0"
  }
}
