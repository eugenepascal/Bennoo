rules_version = '2';

// Bennoo — règles d'accès Firestore (étapes 1 à 4 : comptes, familles, événements, tâches,
// budget et contributions, invités et réponses).
//
// Ces règles SONT la sécurité de l'application : le site est public, seul Firestore
// décide qui lit et écrit quoi. Tout ce qui n'est pas autorisé ici est refusé.
// Les comptes, mots de passe et sessions sont gérés par Firebase Authentication,
// pas par Firestore : aucune règle n'est nécessaire pour eux.
//
// Structure :
//   users/{uid}                                       profil privé
//   families/{fid}                                    famille
//   families/{fid}/members/{uid}                      appartenance (owner | admin | member)
//   families/{fid}/invites/{token}                    lien d'invitation (7 jours)
//   families/{fid}/events/{eid}                       événement
//   families/{fid}/events/{eid}/participants/{uid}    rôle dans l'événement (organizer | treasurer | member)
//     .../participants/{uid}/myContributions/{cid}    index personnel « mes contributions »
//   families/{fid}/events/{eid}/tasks/{tid}           tâche
//   families/{fid}/events/{eid}/expenses/{xid}        dépense (organisateur et trésorier)
//   families/{fid}/events/{eid}/contributions/{cid}   contribution (+ private/identity si anonyme)
//   families/{fid}/events/{eid}/summary/{budget|guests}  totaux lisibles par tous les participants
//   families/{fid}/events/{eid}/guests/{jeton}        foyer invité, répond sans compte avec son lien
//   families/{fid}/events/{eid}/public/invitation     carton d'invitation lisible avec le lien

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Outils ──────────────────────────────────────────────────────────────
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    // Écrire dans une famille exige un email vérifié : un lien d'invitation transféré
    // ne suffit pas à agir sous une fausse adresse.
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function data() { return request.resource.data; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function text(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function optText(v, max) { return v == null || text(v, 0, max); }

    function familyPath(fid) { return /databases/$(database)/documents/families/$(fid); }
    function memberPath(fid, uid) { return /databases/$(database)/documents/families/$(fid)/members/$(uid); }
    function isFamilyMember(fid) { return exists(memberPath(fid, me())); }
    function familyRole(fid) { return get(memberPath(fid, me())).data.role; }
    function isFamilyAdmin(fid) { return isFamilyMember(fid) && familyRole(fid) in ['owner', 'admin']; }

    function eventPath(fid, eid) { return /databases/$(database)/documents/families/$(fid)/events/$(eid); }
    function participantPath(fid, eid, uid) { return /databases/$(database)/documents/families/$(fid)/events/$(eid)/participants/$(uid); }
    function isParticipant(fid, eid) { return exists(participantPath(fid, eid, me())); }
    function eventRole(fid, eid) { return get(participantPath(fid, eid, me())).data.role; }
    function isOrganizer(fid, eid) { return isParticipant(fid, eid) && eventRole(fid, eid) == 'organizer'; }
    function isTreasurer(fid, eid) { return isParticipant(fid, eid) && eventRole(fid, eid) == 'treasurer'; }
    function isManager(fid, eid) { return isParticipant(fid, eid) && eventRole(fid, eid) in ['organizer', 'treasurer']; }
    function nat(v) { return v is int && v >= 0 && v <= 100000000000; }
    function money(v) { return v is int && v > 0 && v <= 100000000000; }
    function optDate(v) { return v == null || v is timestamp; }
    function contributionPath(fid, eid, cid) { return /databases/$(database)/documents/families/$(fid)/events/$(eid)/contributions/$(cid); }
    function identityPath(fid, eid, cid) { return /databases/$(database)/documents/families/$(fid)/events/$(eid)/contributions/$(cid)/private/identity; }
    function myContributionPath(fid, eid, cid) { return /databases/$(database)/documents/families/$(fid)/events/$(eid)/participants/$(me())/myContributions/$(cid); }
    function eventTypes() { return ['WEDDING', 'NAMING_CEREMONY', 'COMMUNION', 'BIRTHDAY', 'RELIGIOUS_CEREMONY', 'FAMILY_REUNION', 'TRADITIONAL_CEREMONY', 'CUSTOM']; }

    // ─── Profil : visible et modifiable par son seul propriétaire ────────────
    match /users/{userId} {
      function validProfile() {
        return data().keys().hasOnly(['displayName', 'phone', 'locale', 'createdAt', 'updatedAt'])
          && text(data().displayName, 1, 80)
          && (data().phone == null || (data().phone is string && data().phone.matches('^\\+[1-9][0-9]{6,14}$')))
          && data().locale in ['fr']
          && data().updatedAt == request.time;
      }
      allow get: if signedIn() && me() == userId;
      allow create: if signedIn() && me() == userId && validProfile() && data().createdAt == request.time;
      allow update: if signedIn() && me() == userId && validProfile() && data().createdAt == resource.data.createdAt;
      allow list, delete: if false;
    }

    // ─── Familles ────────────────────────────────────────────────────────────
    match /families/{fid} {
      function validFamily() {
        return data().keys().hasOnly(['name', 'createdBy', 'createdAt']) && text(data().name, 1, 80);
      }
      allow get: if verified() && isFamilyMember(fid);
      // Créée dans le même lot d'écriture que l'appartenance « owner » de son créateur.
      allow create: if verified() && validFamily()
        && data().createdBy == me() && data().createdAt == request.time
        && getAfter(memberPath(fid, me())).data.role == 'owner';
      allow update: if verified() && isFamilyAdmin(fid) && validFamily() && changed().hasOnly(['name']);
      allow list, delete: if false;

      // Appartenances
      match /members/{memberId} {
        function validMember() {
          return data().keys().hasOnly(['uid', 'role', 'displayName', 'joinedAt', 'inviteToken'])
            && data().uid == memberId && text(data().displayName, 1, 80);
        }
        function validInvite(token) {
          return token is string
            && exists(/databases/$(database)/documents/families/$(fid)/invites/$(token))
            && get(/databases/$(database)/documents/families/$(fid)/invites/$(token)).data.expiresAt > request.time;
        }
        allow read: if verified() && isFamilyMember(fid);
        allow create: if verified() && memberId == me() && validMember() && data().joinedAt == request.time && (
          // fondateur : la famille naît dans le même lot
          (data().role == 'owner' && !exists(familyPath(fid)) && getAfter(familyPath(fid)).data.createdBy == me()
            && !('inviteToken' in data()))
          // invité : un lien valide, jamais un rôle supérieur à « member »
          || (data().role == 'member' && validInvite(data().inviteToken))
        );
        // Un admin change le rôle des autres (admin <-> member) ; le propriétaire ne change jamais.
        allow update: if verified() && (
          (isFamilyAdmin(fid) && memberId != me() && resource.data.role != 'owner'
            && changed().hasOnly(['role']) && data().role in ['admin', 'member'])
          || (memberId == me() && changed().hasOnly(['displayName']) && text(data().displayName, 1, 80))
        );
        // On peut quitter une famille, ou en être retiré par un admin ; jamais le propriétaire.
        allow delete: if verified() && resource.data.role != 'owner'
          && (memberId == me() || isFamilyAdmin(fid));
      }

      // Liens d'invitation : l'identifiant du document EST le jeton secret (32 octets aléatoires).
      // Lecture unitaire possible avec le jeton ; la liste est réservée aux admins.
      match /invites/{token} {
        allow get: if verified();
        allow list: if verified() && isFamilyAdmin(fid);
        allow create: if verified() && isFamilyAdmin(fid) && token.size() == 43
          && data().keys().hasOnly(['familyName', 'createdBy', 'createdAt', 'expiresAt'])
          && text(data().familyName, 1, 80)
          && data().createdBy == me() && data().createdAt == request.time
          // 7 jours demandés par l'application ; 1 jour de tolérance pour l'horloge du téléphone.
          && data().expiresAt is timestamp && data().expiresAt > request.time
          && data().expiresAt <= request.time + duration.value(8, 'd');
        allow delete: if verified() && isFamilyAdmin(fid);
        allow update: if false;
      }

      // ─── Événements : visibles par leurs seuls participants ────────────────
      match /events/{eid} {
        function validEvent() {
          return data().keys().hasOnly(['type', 'title', 'description', 'startsAt', 'venue', 'city',
              'currency', 'budgetPlanned', 'expectedGuests', 'status', 'createdBy', 'createdAt', 'updatedAt'])
            && data().type in ['WEDDING', 'NAMING_CEREMONY', 'COMMUNION', 'BIRTHDAY', 'RELIGIOUS_CEREMONY',
                               'FAMILY_REUNION', 'TRADITIONAL_CEREMONY', 'CUSTOM']
            && text(data().title, 1, 120)
            && optText(data().description, 2000)
            && (data().startsAt == null || data().startsAt is timestamp)
            && optText(data().venue, 200) && optText(data().city, 120)
            && data().currency in ['XOF', 'EUR']
            && data().budgetPlanned is int && data().budgetPlanned >= 0 && data().budgetPlanned <= 100000000000
            && (data().expectedGuests == null || (data().expectedGuests is int
                && data().expectedGuests >= 0 && data().expectedGuests <= 100000))
            && data().status in ['active', 'archived']
            && data().updatedAt == request.time;
        }
        allow get: if verified() && isParticipant(fid, eid);
        allow list: if false; // on passe par « mes événements » (participants)
        // Tout membre de la famille peut créer un événement ; il en devient organisateur dans le même lot.
        allow create: if verified() && isFamilyMember(fid) && validEvent()
          && data().createdBy == me() && data().createdAt == request.time && data().status == 'active'
          && getAfter(participantPath(fid, eid, me())).data.role == 'organizer';
        allow update: if verified() && isOrganizer(fid, eid) && validEvent()
          && data().createdBy == resource.data.createdBy && data().createdAt == resource.data.createdAt;
        allow delete: if false;

        match /participants/{pid} {
          function validParticipant() {
            return data().keys().hasOnly(['uid', 'role', 'displayName', 'addedAt'])
              && data().uid == pid && text(data().displayName, 1, 80)
              && data().role in ['organizer', 'treasurer', 'member'];
          }
          allow read: if verified() && isParticipant(fid, eid);
          allow create: if verified() && validParticipant() && data().addedAt == request.time && (
            // le créateur de l'événement, dans le même lot que l'événement
            (pid == me() && data().role == 'organizer' && !exists(eventPath(fid, eid))
              && getAfter(eventPath(fid, eid)).data.createdBy == me())
            // un organisateur ajoute un membre de la famille
            || (isOrganizer(fid, eid) && exists(memberPath(fid, pid))
                && data().displayName == get(memberPath(fid, pid)).data.displayName)
          );
          // Un organisateur change le rôle des AUTRES : il reste donc toujours au moins un organisateur.
          allow update: if verified() && isOrganizer(fid, eid) && pid != me()
            && validParticipant() && changed().hasOnly(['role']);
          allow delete: if verified() && (
            (isOrganizer(fid, eid) && pid != me())
            || (pid == me() && resource.data.role != 'organizer')
          );

          // Index personnel des contributions : visible et modifiable par son seul propriétaire.
          match /myContributions/{cid} {
            allow read, delete: if verified() && pid == me();
            allow create: if verified() && pid == me() && data().keys().hasOnly(['createdAt'])
              && data().createdAt == request.time
              && getAfter(identityPath(fid, eid, cid)).data.uid == me();
          }
        }

        // ─── Tâches : tous les participants les voient ─────────────────────
        match /tasks/{tid} {
          function validTask() {
            return data().keys().hasOnly(['title', 'notes', 'dueAt', 'status', 'assigneeUid', 'assigneeName', 'createdBy', 'createdAt', 'updatedAt'])
              && text(data().title, 1, 120) && optText(data().notes, 1000) && optDate(data().dueAt)
              && data().status in ['todo', 'doing', 'done']
              && ((data().assigneeUid == null && data().assigneeName == null)
                || (data().assigneeUid is string && exists(participantPath(fid, eid, data().assigneeUid)) && text(data().assigneeName, 1, 80)))
              && data().updatedAt == request.time;
          }
          allow read: if verified() && isParticipant(fid, eid);
          allow create: if verified() && isOrganizer(fid, eid) && validTask()
            && data().createdBy == me() && data().createdAt == request.time;
          // L'organisateur modifie tout ; le responsable d'une tâche change seulement son statut.
          allow update: if verified() && validTask()
            && data().createdBy == resource.data.createdBy && data().createdAt == resource.data.createdAt
            && (isOrganizer(fid, eid) || (resource.data.assigneeUid == me() && changed().hasOnly(['status', 'updatedAt'])));
          allow delete: if verified() && isOrganizer(fid, eid);
        }

        // ─── Dépenses : organisateur et trésorier seulement ────────────────
        match /expenses/{xid} {
          function validExpense() {
            return data().keys().hasOnly(['label', 'category', 'amount', 'supplier', 'spentAt', 'status', 'createdBy', 'createdAt', 'updatedAt'])
              && text(data().label, 1, 120)
              && data().category in ['VENUE', 'CATERING', 'DECOR', 'OUTFITS', 'PHOTO', 'MUSIC', 'TRANSPORT', 'GIFTS', 'OTHER']
              && money(data().amount) && optText(data().supplier, 120) && optDate(data().spentAt)
              && data().status in ['pending', 'paid'] && data().updatedAt == request.time;
          }
          allow read: if verified() && isManager(fid, eid);
          allow create: if verified() && isManager(fid, eid) && validExpense()
            && data().createdBy == me() && data().createdAt == request.time;
          allow update: if verified() && isManager(fid, eid) && validExpense()
            && data().createdBy == resource.data.createdBy && data().createdAt == resource.data.createdAt;
          allow delete: if verified() && isManager(fid, eid);
        }

        // ─── Contributions ─────────────────────────────────────────────────
        // Pas de paiement dans l'application : on déclare, le trésorier confirme.
        // Anonymat : displayName est vide ; l'identité est dans private/identity, lisible
        // par le contributeur et le trésorier seulement (l'organisateur ne la voit pas).
        match /contributions/{cid} {
          function validContribution() {
            return data().keys().hasOnly(['amount', 'status', 'anonymous', 'displayName', 'source', 'note', 'createdAt', 'updatedAt'])
              && money(data().amount) && data().status in ['promised', 'declared', 'confirmed']
              && ((data().anonymous == true && data().displayName == null) || (data().anonymous == false && text(data().displayName, 1, 80)))
              && data().source in ['self', 'treasurer'] && optText(data().note, 200)
              && data().updatedAt == request.time;
          }
          function isMine() { return exists(myContributionPath(fid, eid, cid)); }
          allow get: if verified() && (isManager(fid, eid) || isMine());
          allow list: if verified() && isManager(fid, eid);
          allow create: if verified() && validContribution() && data().createdAt == request.time && (
            // un participant, pour lui-même : promise ou déclarée, jamais confirmée
            (data().source == 'self' && isParticipant(fid, eid) && data().status in ['promised', 'declared']
              && (data().anonymous == true || data().displayName == get(participantPath(fid, eid, me())).data.displayName)
              && getAfter(identityPath(fid, eid, cid)).data.uid == me()
              && existsAfter(myContributionPath(fid, eid, cid)))
            // le trésorier, pour un proche sans compte
            || (data().source == 'treasurer' && isTreasurer(fid, eid) && data().anonymous == false)
          );
          allow update: if verified() && validContribution()
            && data().source == resource.data.source && data().createdAt == resource.data.createdAt
            && data().anonymous == resource.data.anonymous && data().displayName == resource.data.displayName
            && (
              (isTreasurer(fid, eid) && changed().hasOnly(['status', 'amount', 'note', 'updatedAt']))
              || (isMine() && resource.data.status != 'confirmed' && data().status in ['promised', 'declared']
                && changed().hasOnly(['amount', 'status', 'note', 'updatedAt']))
            );
          allow delete: if verified() && (isTreasurer(fid, eid) || (isMine() && resource.data.status != 'confirmed'));

          match /private/{docId} {
            allow get: if verified() && docId == 'identity' && (isTreasurer(fid, eid) || resource.data.uid == me());
            allow create: if verified() && docId == 'identity' && data().keys().hasOnly(['uid', 'displayName'])
              && data().uid == me() && data().displayName == get(participantPath(fid, eid, me())).data.displayName
              && !exists(contributionPath(fid, eid, cid)) && getAfter(contributionPath(fid, eid, cid)).data.source == 'self';
            allow delete: if verified() && docId == 'identity' && (isTreasurer(fid, eid) || resource.data.uid == me());
            allow list, update: if false;
          }
        }

        // ─── Totaux partagés : un simple membre ne voit que ces chiffres ──
        match /summary/{sid} {
          allow read: if verified() && isParticipant(fid, eid);
          allow create, update: if verified() && data().updatedAt == request.time && (
            (sid == 'budget' && isManager(fid, eid)
              && data().keys().hasOnly(['spent', 'paid', 'confirmed', 'pending', 'contributors', 'updatedAt'])
              && nat(data().spent) && nat(data().paid) && nat(data().confirmed) && nat(data().pending) && nat(data().contributors))
            || (sid == 'guests' && isOrganizer(fid, eid)
              && data().keys().hasOnly(['households', 'invited', 'yes', 'no', 'pending', 'attending', 'updatedAt'])
              && nat(data().households) && nat(data().invited) && nat(data().yes) && nat(data().no)
              && nat(data().pending) && nat(data().attending))
          );
          allow delete: if false;
        }

        // ─── Invités : liste réservée aux organisateurs ; réponse sans compte ──
        // L'identifiant du document est un jeton secret de 43 caractères : qui a le lien
        // peut lire SON invitation et y répondre, rien d'autre.
        match /guests/{token} {
          function validGuest() {
            return data().keys().hasOnly(['household', 'phone', 'seats', 'response', 'attending', 'message', 'respondedAt', 'createdBy', 'createdAt'])
              && text(data().household, 1, 120)
              && (data().phone == null || (data().phone is string && data().phone.matches('^\\+[1-9][0-9]{6,14}$')))
              && data().seats is int && data().seats >= 1 && data().seats <= 50
              && data().response in ['pending', 'yes', 'no'] && optText(data().message, 500);
          }
          allow get: if true;
          allow list: if verified() && isOrganizer(fid, eid);
          allow create: if verified() && isOrganizer(fid, eid) && token.size() == 43 && validGuest()
            && data().response == 'pending' && data().attending == null && data().message == null && data().respondedAt == null
            && data().createdBy == me() && data().createdAt == request.time;
          allow update: if validGuest() && (
            // l'invité répond (oui avec 1 à « places » personnes, ou non)
            (changed().hasOnly(['response', 'attending', 'message', 'respondedAt']) && data().respondedAt == request.time
              && ((data().response == 'yes' && data().attending is int && data().attending >= 1 && data().attending <= data().seats)
                || (data().response == 'no' && data().attending == 0)))
            // l'organisateur corrige le foyer
            || (verified() && isOrganizer(fid, eid) && changed().hasOnly(['household', 'phone', 'seats'])
              && (data().attending == null || data().attending <= data().seats))
          );
          allow delete: if verified() && isOrganizer(fid, eid);
        }

        // ─── Carton d'invitation : lisible avec le lien, publié par l'organisateur ──
        match /public/{docId} {
          allow get: if docId == 'invitation';
          allow list, delete: if false;
          allow create, update: if verified() && isOrganizer(fid, eid) && docId == 'invitation'
            && data().keys().hasOnly(['title', 'type', 'startsAt', 'venue', 'city', 'hosts', 'message', 'updatedAt'])
            && text(data().title, 1, 120) && data().type in eventTypes() && optDate(data().startsAt)
            && optText(data().venue, 200) && optText(data().city, 120)
            && optText(data().hosts, 120) && optText(data().message, 500)
            && data().updatedAt == request.time;
        }
      }
    }

    // ─── Requêtes « mes familles » / « mes événements » ──────────────────────
    // Chacun ne lit, à travers toutes les familles, que ses propres lignes d'appartenance.
    match /{path=**}/members/{memberId} {
      allow list: if verified() && resource.data.uid == me();
    }
    match /{path=**}/participants/{pid} {
      allow list: if verified() && resource.data.uid == me();
    }
  }
}
